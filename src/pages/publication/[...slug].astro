---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const publications = await getCollection('publications');

  return publications.map(pub => {
    // Extract slug from permalink (e.g., "/publication/2008-01-01-Name" -> "2008-01-01-Name")
    const permalink = pub.data.permalink;
    const slug = permalink.replace(/^\/publication\//, '');

    return {
      params: { slug },
      props: { publication: pub },
    };
  });
}

const { publication } = Astro.props;
const { Content } = await render(publication);
---

<BaseLayout title={publication.data.title}>
  <article class="publication">
    <header>
      <h1>{publication.data.title}</h1>
      <p class="meta">
        <span class="venue">{publication.data.venue}</span>
        <span class="date">{publication.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
      </p>
    </header>

    {publication.data.paperurl && (
      <p class="paper-link">
        <a href={publication.data.paperurl} target="_blank" rel="noopener">Access paper here</a>
      </p>
    )}

    <section class="content">
      <Content />
    </section>

    <footer class="citation">
      <h2>Citation</h2>
      <p>{publication.data.citation}</p>
    </footer>
  </article>
</BaseLayout>

<style>
  .publication {
    max-width: 100%;
  }

  h1 {
    font-size: 1.75rem;
    line-height: 1.3;
    margin-bottom: var(--space-sm);
  }

  .meta {
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
  }

  .meta .venue {
    display: block;
    font-style: italic;
  }

  .meta .date {
    display: block;
    font-size: 0.875rem;
  }

  .paper-link {
    margin-bottom: var(--space-md);
  }

  .paper-link a {
    display: inline-block;
    padding: var(--space-xs) var(--space-sm);
    background: var(--color-link);
    color: white;
    border-radius: 4px;
    text-decoration: none;
  }

  .paper-link a:hover {
    background: var(--color-link-hover);
    color: white;
  }

  .content {
    margin-bottom: var(--space-lg);
  }

  .citation {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-md);
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .citation h2 {
    font-size: 1rem;
    margin-bottom: var(--space-xs);
  }
</style>
