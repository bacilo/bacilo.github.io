---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const portfolio = await getCollection('portfolio');

  return portfolio.map(project => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={`${project.data.title} - Portfolio`}>
  <article class="project">
    <header>
      <h1>{project.data.title}</h1>
      {project.data.image && (
        <img src={project.data.image} alt={project.data.title} class="project-image" />
      )}
      {(project.data.description || project.data.excerpt) && (
        <p class="description">{project.data.description || project.data.excerpt}</p>
      )}
      <div class="project-links">
        {project.data.repoUrl && (
          <a href={project.data.repoUrl} class="link-button">View Repo</a>
        )}
        {project.data.demoUrl && (
          <a href={project.data.demoUrl} class="link-button">Live Demo</a>
        )}
        {project.data.playgroundUrl && (
          <a href={project.data.playgroundUrl} class="link-button">Playground</a>
        )}
      </div>
    </header>

    <section class="content">
      {project.body?.includes('<script') ? (
        <Fragment set:html={project.body} />
      ) : (
        <Content />
      )}
    </section>
  </article>
</BaseLayout>

<style>
  .project {
    max-width: 100%;
  }

  h1 {
    font-size: 1.75rem;
    line-height: 1.3;
    margin-bottom: var(--space-sm);
  }

  .project-image {
    max-width: 100%;
    max-height: 300px;
    object-fit: contain;
    border-radius: 4px;
    margin-bottom: var(--space-sm);
  }

  .description {
    color: var(--color-text-muted);
    margin-bottom: var(--space-sm);
  }

  .project-links {
    display: flex;
    gap: var(--space-xs);
    margin-bottom: var(--space-md);
  }

  .link-button {
    padding: var(--space-xs) var(--space-sm);
    background: var(--color-link);
    color: var(--color-bg);
    border-radius: 4px;
    text-decoration: none;
    font-size: 0.875rem;
    transition: all 0.2s ease;
  }

  .link-button:hover {
    background: var(--color-link-hover);
  }

  /* Prose styling for markdown content - matches blog post styles */
  .content {
    margin-top: var(--space-md);
    line-height: 1.7;
  }

  .content :global(h1),
  .content :global(h2),
  .content :global(h3),
  .content :global(h4) {
    margin-top: var(--space-md);
    margin-bottom: var(--space-sm);
    line-height: 1.3;
    font-weight: 600;
  }

  .content :global(h2) { font-size: 1.5rem; }
  .content :global(h3) { font-size: 1.25rem; }
  .content :global(h4) { font-size: 1.125rem; }

  .content :global(p) { margin-bottom: var(--space-sm); }
  .content :global(strong) { font-weight: 600; }
  .content :global(em) { font-style: italic; }

  .content :global(ul),
  .content :global(ol) {
    margin-bottom: var(--space-sm);
    padding-left: 1.5rem;
  }

  .content :global(li) { margin-bottom: 0.25rem; }
  .content :global(li > p) { margin-bottom: 0.5rem; }

  .content :global(blockquote) {
    border-left: 4px solid var(--color-link);
    padding-left: var(--space-sm);
    margin: var(--space-md) 0;
    color: var(--color-text-muted);
    font-style: italic;
  }

  .content :global(blockquote p) { margin-bottom: 0.5rem; }

  .content :global(code) {
    font-family: var(--font-mono);
    background: var(--color-header-bg);
    padding: 0.2em 0.4em;
    border-radius: 3px;
    font-size: 0.9em;
  }

  .content :global(pre) {
    padding: var(--space-sm);
    border-radius: 4px;
    overflow-x: auto;
    margin: var(--space-sm) 0;
    font-size: 0.9em;
  }

  .content :global(pre code) {
    background: none;
    padding: 0;
    font-size: inherit;
  }

  .content :global(a) {
    color: var(--color-link);
    text-decoration: underline;
  }

  .content :global(a:hover) { color: var(--color-link-hover); }

  .content :global(img) {
    max-width: 100%;
    height: auto;
    margin: var(--space-md) 0;
    border-radius: 4px;
  }

  .content :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: var(--space-lg) 0;
  }

  .content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-md) 0;
  }

  .content :global(th),
  .content :global(td) {
    border: 1px solid var(--color-border);
    padding: 0.5rem;
    text-align: left;
  }

  .content :global(th) {
    background: var(--color-header-bg);
    font-weight: 600;
  }
</style>
