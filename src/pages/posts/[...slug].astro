---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');

  return posts.map(post => {
    // Extract slug from permalink (e.g., "/posts/2012/08/blog-post-1/" -> "2012/08/blog-post-1")
    // Handle both with and without trailing slash
    const permalink = post.data.permalink || '';
    let slug = permalink.replace(/^\/posts\//, '').replace(/\/$/, '');

    // If no permalink in frontmatter, generate from date + filename
    if (!slug) {
      const date = post.data.date;
      const year = date.getFullYear();
      const month = String(date.getMonth() + 1).padStart(2, '0');
      // Extract post name from id (filename without date prefix)
      const postName = post.id.replace(/^\d{4}-\d{2}-\d{2}-/, '').replace(/\.md$/, '');
      slug = `${year}/${month}/${postName}`;
    }

    return {
      params: { slug },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const { Content } = await render(post);

// Format tags for display
const tags = post.data.tags || [];
---

<BaseLayout title={post.data.title}>
  <article class="post">
    <header>
      <h1>{post.data.title}</h1>
      <p class="meta">
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
      </p>
      {tags.length > 0 && (
        <div class="tags">
          {tags.map(tag => (
            <a href={`/tags/${encodeURIComponent(tag.toLowerCase())}/`} class="tag">{tag}</a>
          ))}
        </div>
      )}
    </header>

    <section class="content">
      {post.body?.includes('<script') ? (
        <Fragment set:html={post.body} />
      ) : (
        <Content />
      )}
    </section>
  </article>
</BaseLayout>

<style>
  .post {
    max-width: 100%;
  }

  h1 {
    font-size: 1.75rem;
    line-height: 1.3;
    margin-bottom: var(--space-xs);
  }

  .meta {
    color: var(--color-text-muted);
    margin-bottom: var(--space-sm);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-bottom: var(--space-md);
  }

  .tag {
    display: inline-block;
    background: var(--color-header-bg);
    color: var(--color-text-muted);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .tag:hover {
    background: var(--color-link);
    color: var(--color-bg);
  }

  .content {
    margin-top: var(--space-md);
    line-height: 1.7;
  }

  /* Headings */
  .content :global(h1),
  .content :global(h2),
  .content :global(h3),
  .content :global(h4) {
    margin-top: var(--space-md);
    margin-bottom: var(--space-sm);
    line-height: 1.3;
    font-weight: 600;
  }

  .content :global(h2) {
    font-size: 1.5rem;
  }

  .content :global(h3) {
    font-size: 1.25rem;
  }

  .content :global(h4) {
    font-size: 1.125rem;
  }

  /* Paragraphs and text */
  .content :global(p) {
    margin-bottom: var(--space-sm);
  }

  .content :global(strong) {
    font-weight: 600;
  }

  .content :global(em) {
    font-style: italic;
  }

  /* Lists */
  .content :global(ul),
  .content :global(ol) {
    margin-bottom: var(--space-sm);
    padding-left: 1.5rem;
  }

  .content :global(li) {
    margin-bottom: 0.25rem;
  }

  .content :global(li > p) {
    margin-bottom: 0.5rem;
  }

  /* Blockquotes */
  .content :global(blockquote) {
    border-left: 4px solid var(--color-link);
    padding-left: var(--space-sm);
    margin: var(--space-md) 0;
    color: var(--color-text-muted);
    font-style: italic;
  }

  .content :global(blockquote p) {
    margin-bottom: 0.5rem;
  }

  /* Code */
  .content :global(code) {
    font-family: var(--font-mono);
    background: var(--color-header-bg);
    padding: 0.2em 0.4em;
    border-radius: 3px;
    font-size: 0.9em;
  }

  .content :global(pre) {
    padding: var(--space-sm);
    border-radius: 4px;
    overflow-x: auto;
    margin: var(--space-sm) 0;
    font-size: 0.9em;
  }

  .content :global(pre code) {
    background: none;
    padding: 0;
    font-size: inherit;
  }

  /* Links */
  .content :global(a) {
    color: var(--color-link);
    text-decoration: underline;
  }

  .content :global(a:hover) {
    color: var(--color-link-hover);
  }

  /* Images */
  .content :global(img) {
    max-width: 100%;
    height: auto;
    margin: var(--space-md) 0;
    border-radius: 4px;
  }

  /* Horizontal rules */
  .content :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: var(--space-lg) 0;
  }

  /* Tables */
  .content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-md) 0;
  }

  .content :global(th),
  .content :global(td) {
    border: 1px solid var(--color-border);
    padding: 0.5rem;
    text-align: left;
  }

  .content :global(th) {
    background: var(--color-header-bg);
    font-weight: 600;
  }
</style>
