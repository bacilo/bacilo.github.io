---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');

  return posts.map(post => {
    // Extract slug from permalink (e.g., "/posts/2012/08/blog-post-1/" -> "2012/08/blog-post-1")
    // Handle both with and without trailing slash
    const permalink = post.data.permalink || '';
    let slug = permalink.replace(/^\/posts\//, '').replace(/\/$/, '');

    // If no permalink in frontmatter, generate from date + filename
    if (!slug) {
      const date = post.data.date;
      const year = date.getFullYear();
      const month = String(date.getMonth() + 1).padStart(2, '0');
      // Extract post name from id (filename without date prefix)
      const postName = post.id.replace(/^\d{4}-\d{2}-\d{2}-/, '').replace(/\.md$/, '');
      slug = `${year}/${month}/${postName}`;
    }

    return {
      params: { slug },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const { Content } = await render(post);

// Format tags for display
const tags = post.data.tags || [];
---

<BaseLayout title={post.data.title}>
  <article class="post">
    <header>
      <h1>{post.data.title}</h1>
      <p class="meta">
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
      </p>
      {tags.length > 0 && (
        <div class="tags">
          {tags.map(tag => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
    </header>

    <section class="content">
      <Content />
    </section>
  </article>
</BaseLayout>

<style>
  .post {
    max-width: 100%;
  }

  h1 {
    font-size: 1.75rem;
    line-height: 1.3;
    margin-bottom: var(--space-xs);
  }

  .meta {
    color: var(--color-text-muted);
    margin-bottom: var(--space-sm);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-bottom: var(--space-md);
  }

  .tag {
    display: inline-block;
    background: var(--color-header-bg);
    color: var(--color-text-muted);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
  }

  .content {
    margin-top: var(--space-md);
  }

  .content :global(h1),
  .content :global(h2),
  .content :global(h3) {
    margin-top: var(--space-md);
    margin-bottom: var(--space-sm);
  }
</style>
